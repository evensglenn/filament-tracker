{
  "entities": {
    "ColorPreset": {
      "title": "Color Preset",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "hex": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "hex"
      ]
    },
    "ManagedType": {
      "title": "Filament Type",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "brand": {
          "type": "string"
        },
        "presets": {
          "type": "array",
          "items": {
            "$ref": "#/entities/ColorPreset"
          }
        }
      },
      "required": [
        "id",
        "name",
        "brand",
        "presets"
      ]
    },
    "User": {
      "title": "User",
      "description": "A user's settings: filament types and their color presets",
      "type": "object",
      "properties": {
        "types": {
          "type": "array",
          "items": {
            "$ref": "#/entities/ManagedType"
          }
        },
        "migratedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Set once the v1 data was copied over"
        }
      },
      "required": [
        "types"
      ]
    },
    "Filament": {
      "title": "Filament",
      "description": "A 3D printing filament in the inventory",
      "type": "object",
      "properties": {
        "typeId": {
          "type": "string",
          "description": "id of an entry in the user's types"
        },
        "brand": {
          "type": "string"
        },
        "colorName": {
          "type": "string"
        },
        "colorHex": {
          "type": "string"
        },
        "remainingGrams": {
          "type": "integer",
          "description": "Total grams left over all spools"
        },
        "spoolWeight": {
          "type": "number",
          "description": "Weight of a full spool in grams"
        },
        "notes": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "lastUsedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last print that used this filament"
        }
      },
      "required": [
        "typeId",
        "brand",
        "colorName",
        "colorHex",
        "remainingGrams",
        "spoolWeight",
        "notes",
        "createdAt",
        "updatedAt"
      ]
    },
    "Print": {
      "title": "Print",
      "description": "A logged print and the filament it used",
      "type": "object",
      "properties": {
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "filamentId": {
                "type": "string"
              },
              "typeId": {
                "type": "string"
              },
              "colorName": {
                "type": "string"
              },
              "colorHex": {
                "type": "string"
              },
              "grams": {
                "type": "integer"
              }
            }
          }
        }
      },
      "required": [
        "createdAt",
        "items"
      ]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": "User",
      "description": "User settings"
    },
    "/users/{uid}/filaments/{filamentId}": {
      "schema": "Filament",
      "description": "User's filament inventory"
    },
    "/users/{uid}/prints/{printId}": {
      "schema": "Print",
      "description": "User's print log"
    }
  }
}
