rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Data Model (v2)
    // ===============================================================
    //
    // Everything a user owns lives under users/{uid}.
    //
    // Document: users/{uid}
    //   - types: list (required) - Filament types with their color presets
    //   - migratedAt: timestamp (optional) - Set once the v1 data was copied over
    //
    // Collection: users/{uid}/filaments
    //   - typeId: string (required) - id of an entry in users/{uid}.types
    //   - brand, colorName: string (required)
    //   - colorHex: string (required) - #RRGGBB
    //   - remainingGrams: int (required) - Total over all spools
    //   - spoolWeight: number (required) - Grams in a full spool
    //   - notes: string (required, may be empty)
    //   - createdAt, updatedAt: timestamp (required)
    //   - lastUsedAt: timestamp (optional) - Last print that used it
    //
    // Collection: users/{uid}/prints (append-only log)
    //   - createdAt: timestamp (required)
    //   - items: list (required) - { filamentId, typeId, colorName, colorHex, grams }
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================
    function isValidUser(data) {
      return hasRequiredFields(['types']) &&
             hasOnlyAllowedFields(['types', 'migratedAt']) &&
             data.types is list && data.types.size() <= 200 &&
             (!('migratedAt' in data) || data.migratedAt is timestamp);
    }

    function isValidFilament(data) {
      return hasRequiredFields(['typeId', 'brand', 'colorName', 'colorHex', 'remainingGrams', 'spoolWeight', 'notes', 'createdAt', 'updatedAt']) &&
             hasOnlyAllowedFields(['typeId', 'brand', 'colorName', 'colorHex', 'remainingGrams', 'spoolWeight', 'notes', 'createdAt', 'updatedAt', 'lastUsedAt']) &&
             data.typeId is string && data.typeId.size() > 0 && data.typeId.size() < 100 &&
             data.brand is string && data.brand.size() > 0 && data.brand.size() < 100 &&
             data.colorName is string && data.colorName.size() > 0 && data.colorName.size() < 100 &&
             data.colorHex is string && data.colorHex.matches('^#[0-9A-Fa-f]{6}$') &&
             data.remainingGrams is int && data.remainingGrams >= 0 && data.remainingGrams < 10000000 &&
             data.spoolWeight is number && data.spoolWeight > 0 && data.spoolWeight < 10000 &&
             data.notes is string && data.notes.size() < 1000 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt == request.time &&
             (!('lastUsedAt' in data) || data.lastUsedAt is timestamp);
    }

    function isValidPrint(data) {
      return hasRequiredFields(['createdAt', 'items']) &&
             hasOnlyAllowedFields(['createdAt', 'items']) &&
             data.createdAt == request.time &&
             data.items is list && data.items.size() > 0 && data.items.size() <= 100;
    }

    // ===============================================================
    // Rules
    // ===============================================================
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid) && isValidUser(request.resource.data);

      match /filaments/{filamentId} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid) && isValidFilament(request.resource.data);
        // createdAt can't change after creation
        allow update: if isOwner(uid) && isValidFilament(request.resource.data) &&
                         request.resource.data.createdAt == resource.data.createdAt;
      }

      match /prints/{printId} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid) && isValidPrint(request.resource.data);
      }
    }

    // ===============================================================
    // Legacy (v1) collections: read-only, so the one-time migration can
    // copy them and devices still running the old version can't change
    // data that was already migrated. Remove once all data is migrated.
    // ===============================================================
    match /filaments/{filamentId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    match /userConfigs/{uid} {
      allow read: if isOwner(uid);
    }
  }
}
